# Copy to .env and fill in. Never commit the real .env.

# Backend: `uvicorn api.main:app --env-file .env` loads this file.
DATABASE_URL=sqlite:///./contentiq.db
CORS_ORIGINS=http://localhost:3000
# Load data/sample/sample_posts.csv into an empty database on startup.
SEED_SAMPLE=true
MAX_UPLOAD_MB=20

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
